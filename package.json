{
  "name": "mkttool",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-account posting console cho team marketing (Reddit + Facebook Pages)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "prisma migrate dev",
    "db:upgrade": "tsx --env-file=.env scripts/upgrade-database.ts",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:backup": "tsx --env-file=.env scripts/backup-database.ts",
    "db:backup:remote": "tsx --env-file=.env scripts/backup-database.ts --remote",
    "proxies:import": "tsx --env-file=.env scripts/import-proxies-from-provider-list.ts",
    "proxies:import-sqlite": "tsx --env-file=.env scripts/import-proxies-from-sqlite-backup.ts",
    "vault:keygen": "tsx scripts/generate-vault-key.ts",
    "keys:server-keygen": "tsx scripts/generate-server-signing-key.ts",
    "keys:server-pubkey": "tsx scripts/show-server-public-key.ts",
    "keys:relay-keygen": "tsx scripts/generate-relay-device-key.ts",
    "vault:rekey": "tsx --env-file=.env scripts/rekey-vault-key.ts",
    "vault:smoke": "tsx scripts/smoke-test-identity-vault.ts",
    "rules:smoke": "tsx --env-file=.env scripts/smoke-test-content-rules.ts",
    "facebook:smoke": "tsx --env-file=.env scripts/smoke-test-facebook-pages.ts",
    "facebook:inspect": "tsx --env-file=.env scripts/inspect-facebook-post.ts",
    "health": "tsx --env-file=.env scripts/run-health-check.ts",
    "health:smoke": "tsx --env-file=.env scripts/smoke-test-account-health.ts",
    "postinstall": "prisma generate",
    "auth:check": "tsx --env-file=.env scripts/check-auth-config.ts",
    "vault:testotp": "tsx scripts/generate-test-totp-secret.ts",
    "relay:dev": "tsx relay/src/main.ts",
    "relay:build": "tsx --env-file-if-exists=.env scripts/build-relay-executable.ts",
    "relay:publish": "tsx --env-file=.env scripts/publish-relay-release.ts",
    "relay:verify": "tsx scripts/smoke-test-relay-executable.ts",
    "browser:publish": "tsx --env-file=.env scripts/publish-windows-installer.ts",
    "release:delegation:prepare": "tsx scripts/release-authority/prepare-delegated-release-key.ts",
    "release:manifest:sign": "tsx scripts/sign-compatibility-manifest.ts",
    "release:manifest:publish": "tsx --env-file=.env scripts/publish-compatibility-manifest.ts",
    "release:compatibility:publish": "tsx --env-file=.env scripts/publish-compatibility-manifest.ts",
    "release:ceremony:bundle": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/release-authority/prepare-offline-ceremony-bundle.ps1",
    "release:ceremony:verify": "tsx scripts/release-authority/verify-release-authority-ceremony.ts",
    "mkt-browser:smoke": "tsx scripts/smoke-test-mkt-browser-contract.ts",
    "mkt-browser:proxy-smoke": "tsx scripts/smoke-test-mkt-browser-correct-proxy.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-auth": "^1.6.25",
    "next": "^16.2.12",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.12",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
