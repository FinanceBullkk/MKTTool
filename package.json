{
  "name": "mkttool",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-account posting console cho team marketing (Reddit + Facebook Pages)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "vault:keygen": "tsx scripts/generate-vault-key.ts",
    "vault:smoke": "tsx scripts/smoke-test-identity-vault.ts",
    "rules:smoke": "tsx --env-file=.env scripts/smoke-test-content-rules.ts",
    "vault:testotp": "tsx scripts/generate-test-totp-secret.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "next": "^16.2.12",
    "otplib": "^13.4.1",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.18.12",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
