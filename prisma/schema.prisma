// Kho danh tính (Phase 01) — xem plans/260801-2030-multi-account-posting-console/phase-01-identity-vault.md
//
// Nguyên tắc bất di bất dịch: 1 nick = 1 proxy = 1 vân tay = 1 profile antidetect.
// Reddit shadowban tức thì nếu 2 nick chung IP cùng tương tác một bài.
//
// Mọi field kết thúc bằng `Enc` đều là chuỗi đã mã hóa AES-256-GCM (xem src/lib/crypto).
// Không bao giờ lưu credential dạng trần.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: `url` không còn khai báo ở đây nữa, chuyển sang prisma.config.ts.
datasource db {
  provider = "sqlite"
}

/// Nhân vật: giọng điệu + mảng nội dung. Một nhân vật có thể có nick ở nhiều nền tảng.
/// Tách khỏi Account để mỗi nick giữ được một giọng riêng — nhiều nick viết giống nhau
/// là tự khai cùng một người vận hành.
/// Lưu ý: bộ luật Phase 02 KHÔNG dùng persona. Luật so trùng nội dung xét theo họ nền tảng
/// và duyệt qua mọi nick, xem src/lib/rules/rule-content-similarity.ts.
model Persona {
  id           String    @id @default(cuid())
  name         String    @unique
  voice        String
  contentAngle String
  notes        String?
  createdAt    DateTime  @default(now())
  accounts     Account[]
}

/// Proxy tĩnh, gắn 1:1 với một nick. KHÔNG dùng loại xoay IP, KHÔNG tính theo GB.
model Proxy {
  id          String   @id @default(cuid())
  label       String   @unique
  host        String
  port        Int
  username    String
  passwordEnc String
  country     String
  type        String   @default("STATIC_ISP") // STATIC_ISP | MOBILE — cách mua, KHÔNG phải giao thức
  /// Giao thức mạng, đây mới là thứ trình duyệt cần: http | socks5.
  /// Nhà bán proxy thường cho cả hai trên hai cổng khác nhau — điền sai cổng/giao thức
  /// thì profile không nối được, tệ hơn là lặng lẽ chạy bằng IP nhà.
  protocol    String   @default("http")
  notes       String?
  createdAt   DateTime @default(now())
  account     Account?

  /// Kết quả lần kiểm proxy còn sống gần nhất — xem src/lib/proxies/proxy-liveness-verdict.ts.
  ///
  /// Null nghĩa là CHƯA KIỂM LẦN NÀO, và chỗ nào hiển thị cũng phải nói đúng như vậy:
  /// "chưa kiểm" không phải "còn sống". Cùng nguyên tắc với bộ dò shadowban — không đo được
  /// thì không được báo khỏe.
  lastCheckedAt    DateTime?
  /// OK | DEAD | LEAKING | COUNTRY_MISMATCH | UNKNOWN
  lastCheckVerdict String?
  lastCheckDetail  String?
  /// IP người ngoài nhìn thấy ở lần kiểm gần nhất. Không mã hóa: đây không phải bí mật,
  /// và phải đọc được bằng mắt thì mới đối chiếu với nhà cung cấp proxy được.
  lastExitIp       String?

  @@unique([host, port, username])
}

/// Proxy riêng để dò shadowban từ góc nhìn người ngoài (Phase 03).
/// TUYỆT ĐỐI không dùng để đăng nhập bất kỳ nick nào, kể cả một lần.
///
/// Tách hẳn khỏi `Proxy` chứ không thêm một cờ vào đó, dù hai bảng gần giống nhau: `Proxy`
/// có quan hệ 1:1 với Account, nên một bản ghi nằm trong bảng này thì KHÔNG có đường nào
/// gắn được vào nick. Đó là ràng buộc do cấu trúc ép, không phải do người dùng nhớ.
model ObserverProxy {
  id          String   @id @default(cuid())
  label       String   @unique
  host        String
  port        Int
  username    String
  passwordEnc String
  country     String
  /// Giao thức mạng: http | socks5. Giống `Proxy.protocol` — xem giải thích ở đó.
  protocol    String   @default("http")
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())

  /// Kết quả lần kiểm proxy còn sống gần nhất — bốn cột y hệt `Proxy`, xem giải thích ở đó.
  ///
  /// Ở bảng này chúng quan trọng hơn: proxy của nick chết là mất một nick, còn proxy quan sát
  /// viên chết là MÙ CẢ ĐÀN — mọi kết luận shadowban đều nhìn qua đúng một IP này.
  lastCheckedAt    DateTime?
  lastCheckVerdict String?
  lastCheckDetail  String?
  lastExitIp       String?
}

/// Một lần dò sức khỏe nick từ góc nhìn người ngoài (Phase 03).
///
/// Giữ cả `visiblePosts` lẫn `expectedPosts` chứ không chỉ giữ kết luận: khi Reddit đổi HTML
/// và bộ dò đếm sai, hai con số này là thứ duy nhất cho biết nó sai từ lúc nào.
model HealthCheck {
  id             String   @id @default(cuid())
  accountId      String
  checkedAt      DateTime @default(now())
  /// HEALTHY | WARN | SHADOWBANNED | CHECKPOINT | ERROR — xem src/lib/health/health-verdict.ts.
  /// Không parse được trang thì phải là ERROR, TUYỆT ĐỐI không được là HEALTHY:
  /// bộ dò hỏng mà báo khỏe là kiểu hỏng nguy hiểm nhất của một hệ thống cảnh báo.
  verdict        String
  shadowbanned   Boolean  @default(false)
  karma          Int?
  /// Số bài người ngoài nhìn thấy được, đếm ở trang profile công khai.
  visiblePosts   Int?
  /// Số bài đáng lẽ phải thấy, theo PostJob đã đánh dấu POSTED.
  expectedPosts  Int?
  detail         String?
  screenshotPath String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, checkedAt])
  @@index([checkedAt])
}

model Account {
  id       String @id @default(cuid())
  platform String // REDDIT | FACEBOOK
  username String

  // credential — tất cả đều mã hóa
  passwordEnc      String
  emailAddress     String // email gốc mua kèm nick
  emailPasswordEnc String
  totpSecretEnc    String?

  /// Liên kết 1:1 — BẮT BUỘC với nick Reddit, bỏ trống được với nick Facebook.
  ///
  /// Reddit phải lén: mỗi nick một vân tay, một IP, không được để lộ là cùng chủ. Fanpage thì
  /// đăng bằng Graph API có token chính thức — không mở trình duyệt, không giả vân tay, không
  /// đi qua proxy. Ép hai trường này cho nick Facebook là bắt đốt một proxy thật và bịa một id
  /// profile chỉ để thỏa ràng buộc, rồi chính dữ liệu giả đó nằm lại trong kho.
  ///
  /// `@unique` trên cột nullable vẫn chặn hai nick dùng chung một proxy (SQLite cho phép nhiều
  /// NULL nhưng chỉ một giá trị thật), nên nguyên tắc 1 nick = 1 proxy KHÔNG bị nới cho Reddit.
  /// Chỗ ép "Reddit thì không được trống" nằm ở validatePlatformIdentityFields().
  antidetectProfileId String? @unique // id profile bên MultiZen/AdsPower
  personaId           String
  proxyId             String? @unique // @unique ép quan hệ 1:1, chặn 2 nick chung IP

  // trạng thái vận hành
  status           String    @default("COLD_START") // COLD_START | ALIVE | CHECKPOINT | SHADOWBANNED | DEAD
  quarantineReason String?
  karma            Int       @default(0) // Reddit
  coldStartUntil   DateTime? // trước mốc này chỉ được đọc, cấm đăng

  // nguồn gốc nick — dùng để đánh giá rủi ro và kiểm tra điều kiện subreddit
  platformCreatedAt DateTime? // ngày tạo nick trên nền tảng (tuổi nick)
  purchasedAt       DateTime?
  purchaseNote      String? // nguồn mua, giá, quốc gia gốc

  lastActionAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  persona      Persona       @relation(fields: [personaId], references: [id])
  proxy        Proxy?        @relation(fields: [proxyId], references: [id])
  jobs         PostJob[]
  interactions Interaction[]
  healthChecks HealthCheck[]

  // Nick cá nhân Facebook có thể là quản trị viên của Fanpage (Phase 04).
  facebookConnections FacebookConnection[]
  facebookPages       FacebookPage[]

  @@unique([platform, username])
  @@index([status])
}

/// Đích đăng bài: subreddit hoặc Facebook group/page.
/// minKarma / minAccountAgeDays / promoRatio là đầu vào cho Rules Engine ở Phase 02.
model PlatformTarget {
  id                String   @id @default(cuid())
  platform          String // REDDIT | FACEBOOK_PAGE | FACEBOOK_GROUP
  name              String // "r/selfhosted"
  url               String
  minKarma          Int      @default(0)
  minAccountAgeDays Int      @default(0)
  promoRatio        Int      @default(9) // 9 bài hữu ích : 1 bài quảng cáo
  allowsLinks       Boolean  @default(true)
  active            Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())

  jobs         PostJob[]
  interactions Interaction[]

  /// Fanpage tương ứng nếu đích này đăng được bằng Graph API (Phase 04).
  facebookPage FacebookPage?

  @@unique([platform, name])
}

// ─────────────────────────────────────────────────────────────────────────────
// Hàng đợi content + bộ luật an toàn (Phase 02)
// Xem plans/260801-2030-multi-account-posting-console/phase-02-content-queue-and-safety-rules.md
// ─────────────────────────────────────────────────────────────────────────────

/// Một mẩu content do team viết. Tách khỏi PostJob vì một content có thể
/// được cân nhắc cho nhiều nick — chính chỗ này sinh ra rủi ro trùng nội dung.
model ContentItem {
  id         String    @id @default(cuid())
  title      String
  body       String
  links      String? // JSON array các link trong bài
  type       String // VALUE (hữu ích) | PROMO (có nhắc sản phẩm)
  authorName String // ai trong team viết
  createdAt  DateTime  @default(now())
  jobs       PostJob[]

  @@index([createdAt])
}

/// Một lần đăng đã lên lịch: content nào, nick nào, đích nào, giờ nào.
/// `ruleVerdicts` giữ nguyên kết quả rules engine tại lúc tạo để sau này truy lại được.
model PostJob {
  id             String    @id @default(cuid())
  contentItemId  String
  accountId      String
  targetId       String
  scheduledAt    DateTime
  status         String    @default("PENDING") // PENDING|BLOCKED|POSTED|FAILED|SKIPPED
  ruleVerdicts   String? // JSON kết quả rules engine
  overrideReason String? // bắt buộc nếu người dùng ghi đè luật
  postedUrl      String?
  errorMessage   String?
  postedAt       DateTime?
  createdAt      DateTime  @default(now())

  contentItem ContentItem    @relation(fields: [contentItemId], references: [id])
  account     Account        @relation(fields: [accountId], references: [id])
  target      PlatformTarget @relation(fields: [targetId], references: [id])

  @@index([accountId, scheduledAt])
  @@index([targetId, scheduledAt])
  @@index([status])
}

/// Mọi lần nick chạm vào một thread. Dùng để chặn 2 nick của mình đụng cùng một bài —
/// tín hiệu phối hợp mà Reddit phạt nặng nhất.
model Interaction {
  id        String   @id @default(cuid())
  accountId String
  targetId  String
  threadUrl String
  /// URL đã chuẩn hóa (bỏ query, rút gọn permalink Reddit về id bài) — khóa so đụng độ.
  threadKey String
  kind      String // POST | COMMENT | UPVOTE
  note      String?
  at        DateTime @default(now())

  account Account        @relation(fields: [accountId], references: [id])
  target  PlatformTarget @relation(fields: [targetId], references: [id])

  @@index([threadKey])
  @@index([accountId, at])
  @@index([targetId, at])
}

/// Ngưỡng của bộ luật, chỉnh được mà không phải sửa code (mở bằng `npm run db:studio`).
/// Thiếu key nào thì lấy mặc định trong src/lib/rules/rule-thresholds.ts.
model RuleConfig {
  key   String @id
  value String
}

// ─────────────────────────────────────────────────────────────────────────────
// Facebook Pages qua Graph API chính thức (Phase 04)
// Xem plans/260801-2030-multi-account-posting-console/phase-04-facebook-pages-publisher.md
//
// KHÔNG có model nào cho việc tự đăng vào Group, và sẽ không bao giờ có:
// Meta khai tử `publish_to_groups` tháng 04/2024. Group đăng tay — nhắc việc đi qua
// PostJob với đích FACEBOOK_GROUP để vẫn được bộ luật chấm như mọi bài khác.
// ─────────────────────────────────────────────────────────────────────────────

/// Một lần OAuth với nick cá nhân Facebook — nguồn sinh ra mọi Page token.
///
/// Tách khỏi FacebookPage vì Page token thừa hưởng tuổi thọ của user token này:
/// user token long-lived sống 60 ngày, hết hạn là mọi Page token dưới nó chết theo.
/// Nhét hạn dùng vào từng Page là chép cùng một sự thật ra nhiều dòng.
model FacebookConnection {
  id             String    @id @default(cuid())
  fbUserId       String    @unique
  name           String
  accessTokenEnc String // user token long-lived, đã mã hóa
  expiresAt      DateTime? // null = Facebook không trả về hạn
  /// Nick trong kho danh tính, nếu nick đó đã được nhập. Không bắt buộc để
  /// kết nối được Page trước cả khi mua nick.
  accountId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account Account?       @relation(fields: [accountId], references: [id])
  pages   FacebookPage[]

  @@index([accountId])
}

/// Một Fanpage đã kết nối. `accessTokenEnc` là Page token — quyền rất mạnh, mã hóa như credential nick.
model FacebookPage {
  id             String @id @default(cuid())
  pageId         String @unique // id Page trên Facebook
  name           String
  accessTokenEnc String

  connectionId String
  /// Đích đăng tương ứng — nối để hàng đợi Phase 02 biết job này đăng bằng API.
  /// @unique ép 1 đích : 1 Page, không cho hai Page cùng trỏ về một đích.
  targetId     String? @unique
  /// Quản trị viên trong kho danh tính. Đặt 2 nick làm admin trên Facebook,
  /// mất 1 nick không mất Page — nhưng ở đây chỉ ghi nick chính.
  adminAccountId String?

  tokenValid     Boolean   @default(true)
  tokenCheckedAt DateTime?
  tokenNote      String? // vì sao token bị coi là hỏng, hiện thẳng cho người dùng
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  connection   FacebookConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  target       PlatformTarget?    @relation(fields: [targetId], references: [id])
  adminAccount Account?           @relation(fields: [adminAccountId], references: [id])

  @@index([connectionId])
}

/// Nhật ký thao tác nhạy cảm: mở profile, xem credential, ghi đè luật.
model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  accountId String?
  action    String
  detail    String?

  @@index([at])
  @@index([accountId])
}
