// Kho danh tính (Phase 01) — xem plans/260801-2030-multi-account-posting-console/phase-01-identity-vault.md
//
// Nguyên tắc bất di bất dịch: 1 nick = 1 proxy = 1 vân tay = 1 profile antidetect.
// Reddit shadowban tức thì nếu 2 nick chung IP cùng tương tác một bài.
//
// Mọi field kết thúc bằng `Enc` đều là chuỗi đã mã hóa AES-256-GCM (xem src/lib/crypto).
// Không bao giờ lưu credential dạng trần.
//
// Mỗi field `Enc` phải mang dấu vùng khóa ngay trên cùng dòng — khai báo khóa nào mở được nó:
//   vault:server   — máy chủ giữ khóa, tự giải mã được
//   vault:operator — chỉ cầu nối trên máy người vận hành mở được, máy chủ KHÔNG giữ khóa
// Thêm cột `Enc` mà quên dấu là encrypted-field-registry.test.ts đỏ ngay: chia vùng là quyết
// định phải nghĩ cho từng cột, không được để rơi vào mặc định nào.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: `url` không còn khai báo ở đây nữa, chuyển sang prisma.config.ts.
datasource db {
  provider = "postgresql"
}

/// Proxy tĩnh, gắn 1:1 với một nick. KHÔNG dùng loại xoay IP, KHÔNG tính theo GB.
model Proxy {
  id          String   @id @default(cuid())
  label       String   @unique
  host        String
  port        Int
  username    String
  passwordEnc String // vault:server — máy chủ cần để kiểm proxy sống và đo băng thông
  country     String
  type        String   @default("STATIC_ISP") // STATIC_ISP | MOBILE — cách mua, KHÔNG phải giao thức
  /// Giao thức mạng, đây mới là thứ trình duyệt cần: http | socks5.
  /// Nhà bán proxy thường cho cả hai trên hai cổng khác nhau — điền sai cổng/giao thức
  /// thì profile không nối được, tệ hơn là lặng lẽ chạy bằng IP nhà.
  protocol    String   @default("http")
  notes       String?
  createdAt   DateTime @default(now())
  account     Account?

  /// Kết quả lần kiểm proxy còn sống gần nhất — xem src/lib/proxies/proxy-liveness-verdict.ts.
  ///
  /// Null nghĩa là CHƯA KIỂM LẦN NÀO, và chỗ nào hiển thị cũng phải nói đúng như vậy:
  /// "chưa kiểm" không phải "còn sống". Cùng nguyên tắc với bộ dò shadowban — không đo được
  /// thì không được báo khỏe.
  lastCheckedAt    DateTime?
  /// OK | DEAD | LEAKING | COUNTRY_MISMATCH | UNKNOWN
  lastCheckVerdict String?
  lastCheckDetail  String?
  /// IP người ngoài nhìn thấy ở lần kiểm gần nhất. Không mã hóa: đây không phải bí mật,
  /// và phải đọc được bằng mắt thì mới đối chiếu với nhà cung cấp proxy được.
  lastExitIp       String?

  /// Kết quả lần ĐO BĂNG THÔNG gần nhất — xem src/lib/proxies/proxy-bandwidth-probe.ts.
  ///
  /// Cố ý KHÔNG nằm trong nút "kiểm tất cả proxy": mỗi lượt đo tải 1 MB qua proxy, tức tiêu
  /// 1 MB quota trả tiền. Kiểm proxy còn sống chỉ tốn vài KB nên bấm thoải mái; đo băng thông
  /// phải là một hành động có chủ đích, từng proxy một.
  lastSpeedAt     DateTime?
  /// Megabit/giây, tốc độ TẢI XUỐNG. Float vì proxy chậm cho ra số lẻ dưới 1.
  /// `lastSpeedAt` khác null mà cột này null = đã thử đo nhưng KHÔNG đo được, lý do ở
  /// `lastSpeedDetail`. Không đo được thì không được hiện như chậm.
  /// Xếp hạng nhanh/chậm suy ra từ số này (`gradeBandwidth`), không lưu thành cột riêng để
  /// không bao giờ có chuyện hạng và số đo nói hai điều khác nhau.
  lastSpeedMbps   Float?
  lastSpeedDetail String?

  @@unique([host, port, username])
}

/// Proxy riêng để dò shadowban từ góc nhìn người ngoài (Phase 03).
/// TUYỆT ĐỐI không dùng để đăng nhập bất kỳ nick nào, kể cả một lần.
///
/// Tách hẳn khỏi `Proxy` chứ không thêm một cờ vào đó, dù hai bảng gần giống nhau: `Proxy`
/// có quan hệ 1:1 với Account, nên một bản ghi nằm trong bảng này thì KHÔNG có đường nào
/// gắn được vào nick. Đó là ràng buộc do cấu trúc ép, không phải do người dùng nhớ.
model ObserverProxy {
  id          String   @id @default(cuid())
  label       String   @unique
  host        String
  port        Int
  username    String
  passwordEnc String // vault:server — cùng lý do với Proxy.passwordEnc
  country     String
  /// Giao thức mạng: http | socks5. Giống `Proxy.protocol` — xem giải thích ở đó.
  protocol    String   @default("http")
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())

  /// Kết quả lần kiểm proxy còn sống gần nhất — bốn cột y hệt `Proxy`, xem giải thích ở đó.
  ///
  /// Ở bảng này chúng quan trọng hơn: proxy của nick chết là mất một nick, còn proxy quan sát
  /// viên chết là MÙ CẢ ĐÀN — mọi kết luận shadowban đều nhìn qua đúng một IP này.
  lastCheckedAt    DateTime?
  lastCheckVerdict String?
  lastCheckDetail  String?
  lastExitIp       String?
}

/// Một lần dò sức khỏe nick từ góc nhìn người ngoài (Phase 03).
///
/// Giữ cả `visiblePosts` lẫn `expectedPosts` chứ không chỉ giữ kết luận: khi Reddit đổi HTML
/// và bộ dò đếm sai, hai con số này là thứ duy nhất cho biết nó sai từ lúc nào.
model HealthCheck {
  id             String   @id @default(cuid())
  accountId      String
  checkedAt      DateTime @default(now())
  /// HEALTHY | WARN | SHADOWBANNED | CHECKPOINT | ERROR — xem src/lib/health/health-verdict.ts.
  /// Không parse được trang thì phải là ERROR, TUYỆT ĐỐI không được là HEALTHY:
  /// bộ dò hỏng mà báo khỏe là kiểu hỏng nguy hiểm nhất của một hệ thống cảnh báo.
  verdict        String
  shadowbanned   Boolean  @default(false)
  karma          Int?
  /// Số bài người ngoài nhìn thấy được, đếm ở trang profile công khai.
  visiblePosts   Int?
  /// Số bài đáng lẽ phải thấy, theo PostJob đã đánh dấu POSTED.
  expectedPosts  Int?
  detail         String?
  screenshotPath String?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, checkedAt])
  @@index([checkedAt])
}

/// Khóa chặn hai lượt dò sức khỏe chạy chồng nhau.
///
/// ## Vì sao khóa phải rời khỏi file
///
/// Bản trước là một file trong `data/`, và nó chỉ đúng khi có **đúng một máy** chạy bộ dò —
/// tức đúng nhờ quy ước, không phải nhờ thiết kế. Từ GĐ5 có ít nhất hai nơi cùng chạy: cron
/// trên Railway và nút "Dò cả đàn" trong app. Hai nơi đó không nhìn thấy file của nhau, nên
/// khóa file im lặng mất tác dụng đúng vào lúc nó bắt đầu cần thiết.
///
/// ## Vì sao là một HÀNG chứ không phải advisory lock của Postgres
///
/// Kế hoạch gốc chốt advisory lock. Đổi vì hai lẽ:
///
/// 1. **Advisory lock không mang theo dữ liệu.** Giao diện hỏi "ai đang giữ, giữ bao lâu rồi",
///    nên vẫn phải có một hàng ở đâu đó — tức là hai cơ chế cho một khái niệm, và chúng sớm
///    muộn cũng lệch nhau.
/// 2. **Advisory lock hỏng MỞ.** Nó gắn theo session; Prisma dùng connection pool, và giữ một
///    connection riêng suốt mười phút trên Railway thì lớp proxy cắt lúc nào không biết.
///    Connection chết là Postgres **tự nhả khóa** và lượt thứ hai chen vào được — đúng thứ khóa
///    sinh ra để chặn, mà lại hỏng lặng lẽ. Hàng này hỏng theo chiều ngược: tiến trình chết thì
///    hàng ở lại và ai đó phải chờ tối đa `STALE_AFTER_MS`. Chờ thì phiền, chồng nhau thì mất
///    proxy quan sát viên.
model HealthCheckLock {
  /// Luôn là hằng `HEALTH_CHECK_LOCK_KEY`. Bảng có tối đa MỘT hàng, và `@id` là thứ ép điều đó
  /// ở tầng database — cùng vai trò với cờ `wx` của bản khóa file: tạo được hay đụng phải hàng
  /// đã có, quyết trong một thao tác, không có khe hở giữa "kiểm" và "ghi".
  key String @id

  /// Chuỗi ngẫu nhiên của riêng lượt đang giữ.
  ///
  /// `release()` chỉ xóa hàng khi token khớp. Không có nó thì một lượt chạy quá hạn, bị lượt
  /// khác giành khóa, rồi mới kết thúc — sẽ xóa mất khóa của lượt đang chạy thật.
  token String

  /// Máy và tiến trình đang giữ, để dựng câu "ai đang giữ".
  ///
  /// Có `host` vì từ GĐ5 khóa này bắc qua nhiều máy: "tiến trình 4821" một mình không nói được
  /// gì khi người đọc không biết nó ở máy nào.
  host String
  pid  Int

  /// Mốc bắt đầu. Quá `STALE_AFTER_MS` thì coi là khóa mồ côi và giành được.
  startedAt DateTime
}

/// Lượt gần nhất của một việc chạy theo lịch — thứ giữ cho bộ lịch bắn ĐÚNG MỘT LẦN mỗi ngày.
///
/// ## Vì sao là một hàng chứ không phải một biến trong bộ nhớ
///
/// Bộ lịch sống trong chính web app (xem `src/lib/health/daily-health-check-scheduler.ts`), và
/// web app thì bị khởi động lại: mỗi lần deploy, mỗi lần Railway thay container, mỗi lần tiến
/// trình chết. Một biến trong bộ nhớ mất theo, nên deploy lúc 09:05 là bắn lại lượt vừa chạy
/// lúc 09:00 — hai lượt cách nhau năm phút, đúng thứ `HealthCheckLock` sinh ra để chặn.
///
/// Nó cũng là chỗ **đòi quyền chạy**: `updateMany` có điều kiện `lastRunAt < mốc hẹn` nên hai
/// bản sao của app cùng tick lúc 09:00 thì chỉ một bản đổi được hàng. Quyết trong một lệnh,
/// không có khe hở giữa "đọc" và "ghi" — cùng nguyên tắc với `@id` của `HealthCheckLock`.
///
/// ## Vì sao KHÔNG suy ra từ bảng `HealthCheck`
///
/// "Lần dò gần nhất" trong bảng đó cũng được ghi bởi nút *"Dò lại ngay"* của một nick lẻ. Lấy
/// nó làm mốc thì một lượt dò một nick lúc 08:50 sẽ nuốt mất lượt cả đàn lúc 09:00, và không có
/// gì báo. Hai khái niệm khác nhau thì phải là hai chỗ khác nhau.
model ScheduledJobRun {
  /// Tên việc — hằng khai trong code, ví dụ `daily-health-check`.
  key String @id

  /// Mốc bộ lịch QUYẾT ĐỊNH cho lượt gần nhất — kể cả khi quyết định là "bỏ qua".
  ///
  /// Ghi ngay lúc đòi quyền, TRƯỚC khi biết lượt đó có chạy được không. Cố ý: nếu chỉ ghi khi
  /// chạy thành công thì một lỗi kéo dài (mất proxy quan sát viên chẳng hạn) làm bộ lịch thử
  /// lại mỗi phút suốt mười lăm tiếng. Chuyện gì đã xảy ra thì `outcome` kể.
  lastRunAt DateTime

  /// Máy nào của app đã quyết. Có nhiều bản sao chạy song song thì đây là thứ nói bản nào.
  host String

  /// LAUNCHED | SKIPPED — xem `DailyRunOutcome`. Cùng vai trò với `verdict` của `HealthCheck`:
  /// "không chạy" phải phân biệt được với "chưa tới lượt".
  outcome String

  /// Vì sao lại là kết quả đó, viết cho người đọc trang Sức khỏe.
  detail String?
}

model Account {
  id       String @id @default(cuid())
  platform String // REDDIT | FACEBOOK
  username String

  // credential — tất cả đều mã hóa, và tất cả đều thuộc vùng operator: không luồng nghiệp vụ
  // nào trên máy chủ cần tới chúng, nên máy chủ không giữ khóa mở được.

  /// Mật khẩu của chính nick — `null` với nick đăng nhập bằng tài khoản khác.
  ///
  /// Nick Reddit của team đăng nhập bằng nút *Continue with Google*, tức **không tồn tại** một
  /// mật khẩu Reddit nào. Cột này từng là `NOT NULL`, nên người nhập buộc phải bịa một chuỗi cho
  /// qua ràng buộc — rồi chính chuỗi giả đó nằm lại trong kho, đi vào bản sao lưu, và phải được
  /// canh giữ y như một bí mật thật mà không đổi lại thứ gì. Cùng lớp sai với việc ép nick
  /// Facebook khai proxy (xem `antidetectProfileId` dưới đây).
  ///
  /// Luật "nền tảng nào thì bắt buộc" nằm ở `validatePlatformAccountFields()`. Giao diện đọc
  /// thẳng cột này chứ không đoán theo nền tảng: nút *"Chép mật khẩu nick"* hiện khi và chỉ khi
  /// cột có giá trị, nên một nick lỡ lưu mật khẩu thật vẫn lấy lại được mà nick mới thì không
  /// bao giờ hiện một nút phát ra chuỗi rỗng.
  passwordEnc String? // vault:operator

  /// Email gốc mua kèm nick. Với nick Reddit đây **chính là tài khoản Google** dùng để đăng nhập.
  emailAddress String

  /// Mật khẩu của `emailAddress`. Với nick Reddit đây là mật khẩu Google — thứ thật sự mở được nick.
  emailPasswordEnc String // vault:operator

  /// Mã 2 lớp dạng base32. Với nick Reddit đây là 2FA của **tài khoản Google**, không phải của Reddit.
  totpSecretEnc String? // vault:operator

  /// Liên kết 1:1 — điền ở CHẶNG 2 của luồng nhập nick, không phải lúc khai.
  ///
  /// Reddit phải lén: mỗi nick một vân tay, một IP, không được để lộ là cùng chủ. Fanpage thì
  /// đăng bằng Graph API có token chính thức — không mở trình duyệt, không giả vân tay, không
  /// đi qua proxy. Ép trường này cho nick Facebook là bắt bịa một id chỉ để thỏa ràng buộc, rồi
  /// chính dữ liệu giả đó nằm lại trong kho.
  ///
  /// **Không còn là điều kiện để TẠO nick, kể cả với Reddit** (đổi 07/08/2026). Id profile chỉ
  /// có được sau khi bấm nút "Tạo profile trên máy này" ở trang chi tiết — mà trang đó cần nick
  /// tồn tại trước. Ép lúc tạo là dựng một vòng luẩn quẩn không lối ra. Nay điều kiện đó chấm ở
  /// `describeAccountReadiness()` (cột "Sẵn sàng") và thi hành ở `launch/route.ts`, tức chuyển
  /// từ *chặn lúc nhập* sang *chấm điểm sẵn sàng*.
  ///
  /// `@unique` trên cột nullable vẫn chặn hai nick dùng chung một proxy (Postgres cho phép
  /// nhiều NULL nhưng chỉ một giá trị thật — giống hệt SQLite trước đây, nên đổi nền dữ liệu
  /// KHÔNG nới lỏng ràng buộc này), nên nguyên tắc 1 nick = 1 proxy vẫn nguyên cho Reddit.
  antidetectProfileId String? @unique // id profile bên MultiZen/AdsPower
  proxyId             String? @unique // @unique ép quan hệ 1:1, chặn 2 nick chung IP

  // trạng thái vận hành
  status           String    @default("COLD_START") // COLD_START | ALIVE | CHECKPOINT | SHADOWBANNED | DEAD
  quarantineReason String?
  karma            Int       @default(0) // Reddit
  coldStartUntil   DateTime? // trước mốc này chỉ được đọc, cấm đăng

  /// Lần đầu có người đăng nhập được nick vào profile antidetect của nó.
  ///
  /// ## Vì sao cột này phải tồn tại
  ///
  /// Trước 07/08/2026 hai việc *"có profile"* và *"đã đăng nhập"* dính làm một: người ta tự dựng
  /// profile trong MultiZen, đăng nhập ngay trong đó, **rồi mới** chép id sang MKTTool. Nên
  /// `antidetectProfileId != null` hàm ý nick đã dùng được.
  ///
  /// Nút "Tạo profile trên máy này" đảo ngược thứ tự đó — nó sinh ra một profile **rỗng**: có
  /// proxy, có vân tay, chưa một cookie nào. Không có cột này thì cột "Sẵn sàng" sẽ khoe màu xanh
  /// cho một nick chưa ai đăng nhập lần nào, và chuyện đó chỉ lộ ra vào đúng hôm ai đó ngồi xuống
  /// định đăng bài. Đúng lớp hỏng mà cả dự án tránh ở chỗ khác ("chưa kiểm lần nào" ≠ "khỏe").
  ///
  /// ## Đây là LỜI KHAI, không phải phép đo
  ///
  /// Ghi khi người dùng bấm "Đã đăng nhập được", giống `karma` và `platformCreatedAt`. Quên bấm
  /// thì nick báo đỏ oan — đổi lại nút nằm ngay trong thẻ chứa nút "Mở profile", nên người bấm
  /// chính là người vừa đăng nhập xong. Đo thật thì phải hỏi MultiZen xem profile có cookie phiên
  /// Reddit không, tức thêm một đường ở cầu nối và một lượt cả team cài lại — chưa đáng.
  ///
  /// Migration lấp `firstLoginAt = createdAt` cho nick đã có `antidetectProfileId` lúc chạy, đúng
  /// theo định nghĩa cũ ở trên. Không lấp thì cả đàn nick đang chạy báo đỏ cùng lúc.
  firstLoginAt DateTime?

  // nguồn gốc nick — dùng để đánh giá rủi ro và kiểm tra điều kiện subreddit
  platformCreatedAt DateTime? // ngày tạo nick trên nền tảng (tuổi nick)
  purchasedAt       DateTime?
  purchaseNote      String? // nguồn mua, giá, quốc gia gốc

  /// Giọng viết và mảng nội dung của nick — hai câu ghi chú cho **người sắp ngồi xuống viết**.
  ///
  /// ## Đây là cú hích TRƯỚC khi viết, không phải một phép chặn
  ///
  /// Luật 7 (`rule-content-similarity.ts`) so trùng **văn bản thật**, xét mọi nick trong cùng họ
  /// nền tảng, và KHÔNG đọc hai cột này — đừng viết chú thích nào nói ngược lại. Nó là tấm lưới
  /// sau khi viết. Hai cột này đứng ở đầu kia: người ôm mười nick mà không có gì nhắc làn thì sẽ
  /// viết cả mười bài bằng đúng giọng tự nhiên của mình, rồi bị luật 7 chặn ở phút cuối — mất
  /// trắng công viết. Hai thứ bù nhau chứ không thừa nhau.
  ///
  /// ## Vì sao là hai cột chứ không phải bảng `Persona` riêng (đổi 07/08/2026)
  ///
  /// Từng có bảng đó, với `/personas` CRUD, một mục nav, một bước onboarding, và một khóa ngoại
  /// **bắt buộc**. Đổi lại: hai dòng chữ hiển thị ở trang chi tiết nick. Không một dòng code nào
  /// ngoài phần hiển thị đọc tới nó — kể cả bộ luật. Cái giá thì có thật: chưa tạo nhân vật là
  /// không thêm nổi một nick, và mọi test dựng database phải đẻ một persona chỉ để thỏa khóa ngoại.
  ///
  /// Lý do duy nhất để tách bảng là dùng chung một nhân vật cho nick ở nhiều nền tảng. Ở quy mô
  /// 5-10 nick Reddit + 2-3 nick Facebook, cái đó không đáng một bảng.
  ///
  /// Nullable, và thiếu thì `describeAccountReadiness()` báo `NO_VOICE` — cùng khuôn với
  /// `antidetectProfileId`: chuyển từ *chặn lúc nhập* sang *chấm điểm sẵn sàng*.
  voice        String?
  contentAngle String?

  /// Người phụ trách nick này. Chỉ chủ (hoặc ADMIN) lấy được mật khẩu / OTP của nó.
  ///
  /// Nullable vì nick nhập trước khi có ai được phân công vẫn phải tồn tại được — và vì
  /// xóa một người khỏi team KHÔNG được phép kéo theo nick của họ. Nick chưa có chủ thì
  /// chỉ ADMIN lấy được bí mật, xem `requireNickOwner()`.
  ///
  /// Chỉ chặn đường lấy BÍ MẬT. Tầm nhìn thì không chia: mọi người vẫn thấy nick, job và
  /// lịch sử của nhau, vì luật 8 phải nêu đúng tên nick của đồng nghiệp thì người đọc mới
  /// xử lý được.
  ownerId String?

  /// Chiếc máy đang giữ profile antidetect của nick này.
  ///
  /// `antidetectProfileId` ở trên là **khóa chính của một file SQLite trên đúng một máy** —
  /// MultiZen không đồng bộ profile giữa các máy (đo 07/08/2026: không cloud sync, không
  /// account, không license server; sync chỉ nằm ở roadmap của họ). Nên id profile là một
  /// con số vô nghĩa nếu không nói kèm nó nằm ở máy nào, và ô này là vế thứ hai đó.
  ///
  /// Vé mở profile và vé bí mật đều bay tới chiếc máy khai ở đây, KHÔNG bay tới máy của
  /// người đang bấm nút — xem `resolveNickDeviceRecipient()`. Đó là chỗ ràng buộc này thi hành.
  ///
  /// Nullable vì hai lý do khác nhau: nick Facebook không cần profile lẫn máy (Fanpage đăng
  /// bằng Graph API), và nick vừa nhập chưa gán cụm vẫn phải tồn tại được.
  ///
  /// `SetNull` giống `ownerId`: xóa một người thì máy của họ mất theo (`RelayDevice` cascade),
  /// và nick chỉ **mất ghim** chứ không bị xóa. Nick là tài sản, đăng ký máy là quyền —
  /// mất quyền không được phép kéo theo tài sản.
  ///
  /// Bất biến do `assignAccountCluster()` ép: ô này có giá trị ⟹ `device.userId == ownerId`
  /// và máy chưa bị thu hồi. Postgres không diễn đạt được ràng buộc bắc qua hai bảng mà không
  /// cần trigger, nên khay cảnh báo vận hành soi lại hàng lệch.
  deviceId String?

  lastActionAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  owner        User?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  device       RelayDevice?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  proxy        Proxy?        @relation(fields: [proxyId], references: [id])
  jobs         PostJob[]
  interactions Interaction[]
  healthChecks HealthCheck[]

  // Nick cá nhân Facebook có thể là quản trị viên của Fanpage (Phase 04).
  facebookConnections FacebookConnection[]
  facebookPages       FacebookPage[]

  @@unique([platform, username])
  @@index([status])
  @@index([ownerId])
  @@index([deviceId])
}

/// Đích đăng bài: subreddit hoặc Facebook group/page.
/// minKarma / minAccountAgeDays / promoRatio là đầu vào cho Rules Engine ở Phase 02.
model PlatformTarget {
  id                String   @id @default(cuid())
  platform          String // REDDIT | FACEBOOK_PAGE | FACEBOOK_GROUP
  name              String // "r/selfhosted"
  url               String
  minKarma          Int      @default(0)
  minAccountAgeDays Int      @default(0)
  promoRatio        Int      @default(9) // 9 bài hữu ích : 1 bài quảng cáo
  allowsLinks       Boolean  @default(true)
  active            Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())

  jobs         PostJob[]
  interactions Interaction[]

  /// Fanpage tương ứng nếu đích này đăng được bằng Graph API (Phase 04).
  facebookPage FacebookPage?

  @@unique([platform, name])
}

// ─────────────────────────────────────────────────────────────────────────────
// Hàng đợi content + bộ luật an toàn (Phase 02)
// Xem plans/260801-2030-multi-account-posting-console/phase-02-content-queue-and-safety-rules.md
// ─────────────────────────────────────────────────────────────────────────────

/// Một mẩu content do team viết. Tách khỏi PostJob vì một content có thể
/// được cân nhắc cho nhiều nick — chính chỗ này sinh ra rủi ro trùng nội dung.
model ContentItem {
  id         String    @id @default(cuid())
  title      String
  body       String
  links      String? // JSON array các link trong bài
  type       String // VALUE (hữu ích) | PROMO (có nhắc sản phẩm)
  authorName String // ai trong team viết
  createdAt  DateTime  @default(now())
  jobs       PostJob[]

  @@index([createdAt])
}

/// Một lần đăng đã lên lịch: content nào, nick nào, đích nào, giờ nào.
/// `ruleVerdicts` giữ nguyên kết quả rules engine tại lúc tạo để sau này truy lại được.
model PostJob {
  id             String    @id @default(cuid())
  contentItemId  String
  accountId      String
  targetId       String
  scheduledAt    DateTime
  status         String    @default("PENDING") // PENDING|BLOCKED|POSTED|FAILED|SKIPPED
  ruleVerdicts   String? // JSON kết quả rules engine
  overrideReason String? // bắt buộc nếu người dùng ghi đè luật
  postedUrl      String?
  errorMessage   String?
  postedAt       DateTime?
  createdAt      DateTime  @default(now())

  contentItem ContentItem    @relation(fields: [contentItemId], references: [id])
  account     Account        @relation(fields: [accountId], references: [id])
  target      PlatformTarget @relation(fields: [targetId], references: [id])

  @@index([accountId, scheduledAt])
  @@index([targetId, scheduledAt])
  @@index([status])
}

/// Mọi lần nick chạm vào một thread. Dùng để chặn 2 nick của mình đụng cùng một bài —
/// tín hiệu phối hợp mà Reddit phạt nặng nhất.
model Interaction {
  id        String   @id @default(cuid())
  accountId String
  targetId  String
  threadUrl String
  /// URL đã chuẩn hóa (bỏ query, rút gọn permalink Reddit về id bài) — khóa so đụng độ.
  threadKey String
  kind      String // POST | COMMENT | UPVOTE
  note      String?
  at        DateTime @default(now())

  account Account        @relation(fields: [accountId], references: [id])
  target  PlatformTarget @relation(fields: [targetId], references: [id])

  @@index([threadKey])
  @@index([accountId, at])
  @@index([targetId, at])
}

/// Ngưỡng của bộ luật, chỉnh được mà không phải sửa code (mở bằng `npm run db:studio`).
/// Thiếu key nào thì lấy mặc định trong src/lib/rules/rule-thresholds.ts.
model RuleConfig {
  key   String @id
  value String
}

// ─────────────────────────────────────────────────────────────────────────────
// Facebook Pages qua Graph API chính thức (Phase 04)
// Xem plans/260801-2030-multi-account-posting-console/phase-04-facebook-pages-publisher.md
//
// KHÔNG có model nào cho việc tự đăng vào Group, và sẽ không bao giờ có:
// Meta khai tử `publish_to_groups` tháng 04/2024. Group đăng tay — nhắc việc đi qua
// PostJob với đích FACEBOOK_GROUP để vẫn được bộ luật chấm như mọi bài khác.
// ─────────────────────────────────────────────────────────────────────────────

/// Một lần OAuth với nick cá nhân Facebook — nguồn sinh ra mọi Page token.
///
/// Tách khỏi FacebookPage vì Page token thừa hưởng tuổi thọ của user token này:
/// user token long-lived sống 60 ngày, hết hạn là mọi Page token dưới nó chết theo.
/// Nhét hạn dùng vào từng Page là chép cùng một sự thật ra nhiều dòng.
model FacebookConnection {
  id             String    @id @default(cuid())
  fbUserId       String    @unique
  name           String
  accessTokenEnc String // vault:server — user token long-lived, máy chủ gọi Graph API bằng nó
  expiresAt      DateTime? // null = Facebook không trả về hạn
  /// Nick trong kho danh tính, nếu nick đó đã được nhập. Không bắt buộc để
  /// kết nối được Page trước cả khi mua nick.
  accountId      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  account Account?       @relation(fields: [accountId], references: [id])
  pages   FacebookPage[]

  @@index([accountId])
}

/// Một Fanpage đã kết nối. `accessTokenEnc` là Page token — quyền rất mạnh, mã hóa như credential nick.
model FacebookPage {
  id             String @id @default(cuid())
  pageId         String @unique // id Page trên Facebook
  name           String
  accessTokenEnc String // vault:server — máy chủ đăng bài bằng token này

  connectionId   String
  /// Đích đăng tương ứng — nối để hàng đợi Phase 02 biết job này đăng bằng API.
  /// @unique ép 1 đích : 1 Page, không cho hai Page cùng trỏ về một đích.
  targetId       String? @unique
  /// Quản trị viên trong kho danh tính. Đặt 2 nick làm admin trên Facebook,
  /// mất 1 nick không mất Page — nhưng ở đây chỉ ghi nick chính.
  adminAccountId String?

  tokenValid     Boolean   @default(true)
  tokenCheckedAt DateTime?
  tokenNote      String? // vì sao token bị coi là hỏng, hiện thẳng cho người dùng
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  connection   FacebookConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  target       PlatformTarget?    @relation(fields: [targetId], references: [id])
  adminAccount Account?           @relation(fields: [adminAccountId], references: [id])

  @@index([connectionId])
}

/// Nhật ký thao tác nhạy cảm: mở profile, xem credential, ghi đè luật.
model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  accountId String?
  action    String
  detail    String?

  /// Ai đã làm việc này. Nullable vì hàng ghi trước Phase 02 không có thông tin đó và
  /// **không hồi tố được** — bịa một actor cho chúng còn tệ hơn để trống.
  ///
  /// KHÔNG có `onDelete: SetNull` qua quan hệ: nhật ký kiểm toán phải sống lâu hơn tài
  /// khoản người dùng. Xóa một người mà xóa luôn dấu vết họ đã lộ credential nào thì
  /// nhật ký mất đúng giá trị của nó. Vì vậy đây là cột thường, không phải khóa ngoại.
  actorId String?

  @@index([at])
  @@index([accountId])
  @@index([actorId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Better Auth — đăng nhập Google. Bốn model dưới đây do thư viện quy định hình dạng.
// ─────────────────────────────────────────────────────────────────────────────

/// Người dùng công cụ. KHÔNG phải nick mạng xã hội — nick là model `Account` ở trên.
model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// ADMIN | OPERATOR. Tính từ `ADMIN_EMAILS` ở phía máy chủ lúc tạo tài khoản, và
  /// `input: false` trong cấu hình Better Auth chặn client tự khai vai trò cho mình.
  ///
  /// Đây là bản sao để tiện truy vấn, KHÔNG phải nguồn sự thật: nguồn sự thật là biến
  /// môi trường. Sửa `ADMIN_EMAILS` xong thì cột này lệch cho tới lần đồng bộ kế tiếp,
  /// nên mọi phép kiểm quyền đọc lại danh sách chứ không tin cột này một mình.
  role String @default("OPERATOR")

  sessions      Session[]
  authAccounts  AuthAccount[]
  ownedAccounts Account[]
  relayDevices  RelayDevice[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Liên kết tới nhà cung cấp OAuth (Google). Better Auth gọi model này là `Account`;
/// đổi tên ở đây vì `Account` đã là nick mạng xã hội từ Phase 01 — xem `account.modelName`
/// trong `auth-server.ts`.
model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ─────────────────────────────────────────────────────────────────────────────
// Sổ đăng ký máy chạy cầu nối (Phase 03) — xem
// plans/260804-1752-web-chung-cho-team-phan-tan/phase-03-tach-hai-vung-khoa-va-ve-ky.md
// ─────────────────────────────────────────────────────────────────────────────

/// Một máy đã được ADMIN cho phép nhận vé.
///
/// ## Vì sao máy chủ cần biết từng cái máy
///
/// Nội dung vé được **mã hóa cho riêng máy nhận**, nên máy chủ phải có khóa công khai của
/// đúng cái máy đó trước khi phát vé. Trình duyệt chỉ là người đưa thư: nó cầm vé đi qua
/// nhưng không mở được — kể cả mật khẩu proxy nằm trong đó.
///
/// Lợi thứ hai, và là lý do có cột `revokedAt`: **mất laptop thì thu hồi đúng cái máy đó là
/// xong**, không phải xoay khóa vùng operator trên toàn bộ máy của team.
///
/// ## Ranh giới của việc thu hồi — đọc kỹ trước khi tin vào nó
///
/// Thu hồi chặn **vé mới**. Nó KHÔNG làm mất hiệu lực ciphertext mà máy đó đã lấy về trước
/// đó — thứ ấy nằm trên ổ cứng của chiếc laptop đã mất và không ai với tới được nữa. Mất máy
/// thì vẫn phải xoay `VAULT_KEY_OPERATOR`; thu hồi chỉ là cái chặn có hiệu lực ngay lập tức
/// trong lúc chờ xoay khóa.
model RelayDevice {
  id String @id @default(cuid())

  /// Tên máy do người đăng ký đặt — "Laptop Dell của Hà". Chỉ để người đọc nhận ra máy nào
  /// là máy nào lúc cần thu hồi gấp, không mang ý nghĩa kỹ thuật nào.
  ///
  /// KHÔNG `@unique` theo (người, tên): đăng ký lại sau khi cài lại máy là chuyện bình thường
  /// và người ta sẽ đặt đúng cái tên cũ. Chặn chỗ đó là ép họ đặt tên "Laptop Dell 2".
  name String

  /// Chủ máy. Bắt buộc — một cái máy luôn thuộc về một người cụ thể, và tới Phase 05 việc
  /// phát vé sẽ đối chiếu người đang bấm với chủ máy nhận.
  userId String

  /// Khóa công khai X25519 của máy, 64 ký tự hex thường.
  ///
  /// X25519 chứ không phải Ed25519: cặp khóa của máy chủ dùng để **ký** (Ed25519), còn cặp
  /// khóa này dùng để **mã hóa gửi tới** — hai việc khác nhau, hai họ khóa khác nhau.
  ///
  /// `@unique` là ràng buộc an toàn chứ không phải dọn dẹp: cùng một khóa nằm ở hai hàng thì
  /// thu hồi một hàng vẫn còn hàng kia sống, và người thu hồi tưởng đã chặn xong. Chuẩn hóa
  /// về chữ thường trước khi ghi, vì "AB…" và "ab…" là cùng một khóa nhưng Postgres coi là hai.
  publicKey String @unique

  /// Ngày đăng ký.
  createdAt DateTime @default(now())

  /// Mốc thu hồi. `null` = còn dùng được.
  ///
  /// Mốc thời gian chứ không phải cờ boolean: cùng trả lời được câu "còn dùng không", nhưng
  /// thêm câu "thu hồi từ lúc nào" — thứ luôn cần tới vào đúng ngày phải dựng lại xem một
  /// chiếc máy đã mất còn lấy được gì trước khi bị chặn.
  ///
  /// Thu hồi là MỘT CHIỀU và không có đường hoàn tác: khóa của một chiếc máy đã mất thì coi
  /// như đã lộ, cho bật lại là xóa sạch ý nghĩa của lần thu hồi. Máy tìm lại được thì sinh
  /// cặp khóa mới rồi đăng ký lại như một máy mới.
  revokedAt DateTime?

  /// `Cascade`: xóa một người thì đăng ký máy của họ mất theo. Hỏng về hướng đóng — người
  /// không còn thì máy của họ cũng không nhận vé nữa. (Khác `AuditLog`, vốn phải sống lâu
  /// hơn tài khoản: sổ này là danh sách quyền, không phải dấu vết.)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nick đang ghim vào máy này — xem `Account.deviceId`.
  ///
  /// Thu hồi máy **không bị chặn** bởi danh sách này: mất laptop là đường khẩn cấp, và bắt
  /// người ta gỡ ghim từng nick trước khi chặn được một chiếc máy đã mất là đặt thủ tục lên
  /// trước thiệt hại. `revokeRelayDevice()` gỡ ghim cả loạt trong cùng transaction rồi nói rõ
  /// mấy nick vừa mất ghim.
  accounts Account[]

  /// `VAULT_KEY_OPERATOR` đã bọc cho **riêng chiếc máy này**, đang nằm chờ nó tới lấy.
  ///
  /// Dạng JSON của `SealedPayload` (`{ ephemeralPublicKey, sealed }`) — cùng cơ chế bọc ruột vé,
  /// xem `ticket-sealed-box.ts`. Máy chủ giữ hộ nhưng **mở không nổi**: muốn mở phải có khóa
  /// riêng X25519 của đúng chiếc máy này, thứ không bao giờ rời khỏi nó.
  ///
  /// Vì sao cột này nằm ở đây chứ không ở một bảng "lời mời" riêng: nó **chỉ có nghĩa với một
  /// chiếc máy**. Tách ra bảng riêng là dựng lại đúng thứ vừa gỡ bỏ — một tấm vé lơ lửng ai cầm
  /// cũng dùng được, và kéo theo cả bộ hết hạn / dùng một lần để bù cho chuyện đó.
  operatorKeyGrant String?

  /// Mốc ADMIN bấm cấp. Giữ lại sau khi máy đã nhận, để sổ trả lời được "cấp lúc nào".
  operatorKeyGrantedAt DateTime?

  /// Mốc **chính chiếc máy đó tự báo** rằng nó đã có khóa vùng operator. Lúc đó
  /// `operatorKeyGrant` bị **xóa** — hộp đã tới nơi thì giữ lại chỉ là thêm một thứ để rò nếu
  /// có ngày bản sao lưu lọt ra ngoài.
  ///
  /// Vì sao là "máy tự báo" chứ không phải "đã giao xong": có **hai** đường để một máy có khóa —
  /// được cấp, và người dùng dán tay ở trang trạng thái của cầu nối (đường bootstrap, và là đường
  /// duy nhất cho chiếc máy ĐẦU TIÊN, vì lúc đó chưa có cầu nối nào khác để bọc từ đó). Máy chủ
  /// không thấy được đường thứ hai. Nên cột này ghi đúng thứ nó biết — *"máy đã báo là có"* — chứ
  /// không suy ra từ việc đã cấp hay chưa. Sổ nói sai về việc một máy đã sẵn sàng hay chưa thì
  /// tệ hơn là sổ không nói gì.
  operatorKeyReadyAt DateTime?

  @@index([userId])
}
