# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# Postgres dùng chung. Dạng: postgresql://user:mật_khẩu@host:cổng/tên_database
# Mật khẩu có ký tự đặc biệt (@ / # :) thì phải mã hóa URL, ví dụ "@" viết thành "%40".
# Trỏ ra máy chủ thật (Railway) thì thêm "?sslmode=require" — mật khẩu database là chìa vào
# toàn bộ kho ciphertext, không gửi qua kết nối trần.
DATABASE_URL="postgresql://postgres:mật_khẩu@localhost:5432/mkttool_dev"

# Database RIÊNG cho bộ test. BẮT BUỘC nếu chạy `npm test`.
# Bộ test XÓA SẠCH schema trước mỗi lượt chạy, nên nó chỉ chấp nhận database có tên kết thúc
# bằng "_test" — chốt chặn để không bao giờ xóa nhầm database vận hành. Database phải tạo sẵn;
# bộ test dựng bảng bên trong nó chứ không tự tạo database.
TEST_DATABASE_URL="postgresql://postgres:mật_khẩu@localhost:5432/mkttool_test"

# Múi giờ chuẩn của cả team — BẮT BUỘC, thiếu là app dừng ngay kèm thông báo.
# Quyết định "hôm nay" bắt đầu lúc nào: luật hạn mức ngày, cold-start, giãn cách giữa hai bài,
# và giờ hiển thị đều đọc biến này. Không có nó thì mỗi máy cắt ngày theo giờ của chính nó và
# cùng một job cho hai kết quả khác nhau tùy ai mở — sai lặng lẽ, không có cảnh báo nào.
# Tên phải là múi giờ IANA dạng vùng/thành phố. Đổi giá trị này thì phải BUILD LẠI, vì ô chọn
# giờ chạy ở trình duyệt cũng đọc nó (xem next.config.ts).
TEAM_TIMEZONE="Asia/Ho_Chi_Minh"

# Khóa mã hóa credential — 32 byte dạng hex (64 ký tự).
# Sinh bằng: npm run vault:keygen
# MẤT KHÓA NÀY = MẤT TOÀN BỘ MẬT KHẨU VÀ TOTP SECRET. Sao lưu ở password manager.
VAULT_KEY=""

# Nick Reddit dùng để đối chiếu khi chạy `npm run health:smoke`. Để trống thì dùng "spez"
# (nick sáng lập Reddit — luôn tồn tại, luôn công khai). Không cần đăng nhập, không cần proxy.
HEALTH_SMOKE_USERNAME=""

# Antidetect browser đang dùng: multizen | adspower
ANTIDETECT_PROVIDER="multizen"

# MultiZen: địa chỉ MCP server cục bộ
MULTIZEN_MCP_URL="http://127.0.0.1:7777"

# MultiZen: bearer token — BẮT BUỘC, thiếu là mọi lời gọi ăn HTTP 401.
# Lấy trong app MultiZen: MCP -> "Connect an agent" (hoặc file `mcp-token` ở thư mục dữ liệu app).
MULTIZEN_MCP_TOKEN=""

# AdsPower: địa chỉ local API (chỉ cần khi ANTIDETECT_PROVIDER=adspower)
ADSPOWER_API_URL="http://local.adspower.net:50325"

# ── Facebook Pages (Phase 04) ────────────────────────────────────────────────
# Bỏ trống cũng chạy được cả app; chỉ cần khi muốn đăng Fanpage bằng Graph API.
# Tạo app loại Business ở developers.facebook.com, xin 3 quyền:
#   pages_manage_posts, pages_read_engagement, pages_show_list
# Chế độ Development là đủ cho Page mình sở hữu — không cần App Review.
FACEBOOK_APP_ID=""
# App Secret chỉ nằm ở server, KHÔNG BAO GIỜ gửi xuống trình duyệt.
FACEBOOK_APP_SECRET=""
# Phải khai y hệt chuỗi này trong Meta App — Facebook so từng ký tự.
# Host ở đây cũng phải trùng địa chỉ bạn dùng để mở app: cookie chống CSRF của luồng OAuth
# gắn theo host, và "localhost" với "127.0.0.1" là hai host khác nhau với cookie.
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/facebook/oauth/callback"
# Phiên bản Graph API. Để trống thì dùng mặc định trong facebook-app-config.ts.
FACEBOOK_GRAPH_VERSION=""
# CHỈ điền khi app dùng sản phẩm "Facebook Login for Business" (app loại Business tạo từ 2025
# chỉ thêm được bản này). Lấy ở: Facebook Login for Business -> Configurations -> cột ID.
# Điền vào là quyền lấy theo configuration đó, KHÔNG lấy theo scope trong code nữa — nên phải
# tick đủ pages_manage_posts + pages_read_engagement + pages_show_list khi tạo configuration.
# Dùng Facebook Login thường thì để trống.
FACEBOOK_LOGIN_CONFIG_ID=""
