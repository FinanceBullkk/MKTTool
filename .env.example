# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit .env.

# Postgres dùng chung. Dạng: postgresql://user:mật_khẩu@host:cổng/tên_database
# Mật khẩu có ký tự đặc biệt (@ / # :) thì phải mã hóa URL, ví dụ "@" viết thành "%40".
# Trỏ ra máy chủ thật (Railway) thì thêm "?sslmode=require" — mật khẩu database là chìa vào
# toàn bộ kho ciphertext, không gửi qua kết nối trần.
DATABASE_URL="postgresql://postgres:mật_khẩu@localhost:5432/mkttool_dev"

# Postgres của MÁY CHỦ THẬT — chỉ để `npm run db:backup:remote` hút bản sao về máy này.
# Khai ở .env của MÁY BẠN, KHÔNG khai trên máy chủ (ở đó database đã là DATABASE_URL rồi).
# Lấy biến DATABASE_PUBLIC_URL của dịch vụ Postgres trên Railway rồi thêm "?sslmode=require".
# Để trống thì `db:backup:remote` dừng ngay kèm hướng dẫn — nó KHÔNG bao giờ lùi về DATABASE_URL,
# vì làm vậy là dựng ra một file tên "mkttool-prod-…" chứa dữ liệu máy dev.
PRODUCTION_DATABASE_URL=""

# pg_dump nào sẽ chạy. Để trống thì lấy trên PATH — đúng cho hầu hết máy.
#
# Chỉ cần khai khi máy chủ chạy Postgres major CAO HƠN client cài dưới máy: pg_dump từ chối dump
# từ server mới hơn chính nó, và câu từ chối chỉ nêu hai con số chứ không nói phải làm gì. Đã vấp
# thật 08/08/2026 (Railway ở 18, máy dev ở 17) và nó làm gãy đúng bước sao lưu-trước-khi-deploy.
#
# Cài thêm client mới rồi trỏ vào đây; KHÔNG cần gỡ bản cũ đang dùng cho database dưới máy.
# PG_DUMP_PATH="C:\Program Files\PostgreSQL\18\bin\pg_dump.exe"

# Database RIÊNG cho bộ test. BẮT BUỘC nếu chạy `npm test`.
# Bộ test XÓA SẠCH schema trước mỗi lượt chạy, nên nó chỉ chấp nhận database có tên kết thúc
# bằng "_test" — chốt chặn để không bao giờ xóa nhầm database vận hành. Database phải tạo sẵn;
# bộ test dựng bảng bên trong nó chứ không tự tạo database.
TEST_DATABASE_URL="postgresql://postgres:mật_khẩu@localhost:5432/mkttool_test"

# Múi giờ chuẩn của cả team — BẮT BUỘC, thiếu là app dừng ngay kèm thông báo.
# Quyết định "hôm nay" bắt đầu lúc nào: luật hạn mức ngày, cold-start, giãn cách giữa hai bài,
# và giờ hiển thị đều đọc biến này. Không có nó thì mỗi máy cắt ngày theo giờ của chính nó và
# cùng một job cho hai kết quả khác nhau tùy ai mở — sai lặng lẽ, không có cảnh báo nào.
# Tên phải là múi giờ IANA dạng vùng/thành phố. Đổi giá trị này thì phải BUILD LẠI, vì ô chọn
# giờ chạy ở trình duyệt cũng đọc nó (xem next.config.ts).
TEAM_TIMEZONE="Asia/Ho_Chi_Minh"

# ── Khóa mã hóa credential — hai vùng (GĐ3) ──────────────────────────────────
# Mỗi khóa 32 byte dạng hex (64 ký tự). Sinh bằng: npm run vault:keygen
# MẤT KHÓA = MẤT VĨNH VIỄN phần dữ liệu thuộc vùng đó. Sao lưu ở password manager.
#
# Vùng nào giữ cột nào: xem src/lib/crypto/encrypted-field-registry.ts, và dấu
# `// vault:server` / `// vault:operator` ngay cạnh từng cột trong prisma/schema.prisma.

# Mật khẩu proxy + token Facebook. Máy chủ cần khóa này để kiểm proxy và gọi Graph API.
VAULT_KEY_SERVER=""

# Mật khẩu / email / TOTP của nick. Đích đến: khóa này CHỈ nằm trên máy operator, KHÔNG nằm
# trên máy chủ — chiếm được máy chủ cũng không mở nổi một mật khẩu nick nào.
# Còn để ở đây trong lúc chuyển đổi, tới khi cầu nối (Phase 04) chạy thì gỡ khỏi máy chủ.
#
# Đang nâng cấp từ bản một khóa? Đặt CẢ HAI biến bằng đúng giá trị VAULT_KEY cũ (dữ liệu trong
# database đang mã hóa bằng nó), rồi tách thật bằng:
#   npm run vault:rekey -- --domain=operator --new-key=<hex>
VAULT_KEY_OPERATOR=""

# ── Khóa ký vé (GĐ3) ─────────────────────────────────────────────────────────
# Hạt giống 32 byte hex của khóa riêng Ed25519. Sinh bằng: npm run keys:server-keygen
#
# Máy chủ dùng nó ký vé; cầu nối dùng KHÓA CÔNG KHAI tương ứng để biết vé nào là thật.
# Khóa công khai suy ra từ chính hạt giống này, không khai riêng — hai biến rời nhau là mở
# đường cho một cặp lệch, mà cặp lệch thì mọi vé bị từ chối và không nhìn đâu ra lý do.
#
# Mất khóa này KHÔNG mất dữ liệu, nhưng đổi nó thì mọi cầu nối phải chép lại khóa công khai
# mới, nếu không chúng từ chối sạch vé.
TICKET_SIGNING_KEY=""

# ── Đăng nhập (Phase 02) ─────────────────────────────────────────────────────
# Ai được vào công cụ. BẮT BUỘC — thiếu là app dừng ngay.
# Google chỉ chứng minh "người này sở hữu email đó", KHÔNG chứng minh "người này thuộc team".
# Không có danh sách này thì bất kỳ ai có Gmail cũng mở được kho danh tính.
# Ngăn cách nhau bằng dấu phẩy. Gỡ một email khỏi đây là người đó mất quyền NGAY LẬP TỨC,
# kể cả đang mở sẵn tab — danh sách được kiểm ở mọi request, không phải chỉ lúc đăng nhập.
ALLOWED_EMAILS=""

# Ai là quản trị viên. BẮT BUỘC, phải là tập con của ALLOWED_EMAILS (thiếu thì app báo lỗi
# nêu đích danh email sai). ADMIN phân công được nick cho người khác và lấy được bí mật của
# mọi nick; OPERATOR chỉ lấy được bí mật của nick mình phụ trách.
ADMIN_EMAILS=""

# Khóa ký cookie phiên — 32 byte hex. Sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Đổi khóa này là đăng xuất toàn bộ team ngay lập tức — cách đuổi mọi phiên khi nghi bị lộ.
BETTER_AUTH_SECRET=""

# Địa chỉ gốc của app. Phải khớp TỪNG KÝ TỰ với "Authorized redirect URI" khai ở Google.
# Dùng "localhost" chứ KHÔNG dùng "127.0.0.1": trình duyệt coi hai cái đó là hai host khác
# nhau khi lưu cookie, nên cookie phiên đặt ở một bên không tới được bên kia — đúng cái bẫy
# mà luồng Facebook đã dính (xem README). Lên Railway thì đổi thành https://... của bạn.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client — lấy ở Google Cloud Console, xem hướng dẫn từng bước trong README.
# Redirect URI phải khai là: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Lịch dò shadowban hằng ngày (GĐ5) ────────────────────────────────────────
# Giờ hẹn dạng HH:MM theo TEAM_TIMEZONE. VẮNG MẶT = TẮT LỊCH, và đó là mặc định.
#
# Cố ý để trống trong file mẫu: máy dev nào cũng trỏ vào một database thật, nên một bộ lịch tự
# bật sẵn nghĩa là mỗi lập trình viên mở máy lại bắn một lượt dò tiêu quota proxy quan sát viên.
# Khai nó ở BIẾN MÔI TRƯỜNG CỦA MÁY CHỦ, không phải ở .env của máy mình.
#
# Bộ lịch nằm trong chính web app chứ không dùng cron của hãng — cron của Railway chỉ nhận giờ
# UTC, mà giờ hẹn phải theo giờ team; khai hai nơi là mở đường cho hai giá trị lệch nhau mà
# không có gì báo. Lý do đầy đủ ở src/lib/schedule/daily-run-schedule.ts.
#
# Khai sai dạng thì lịch KHÔNG chạy và khay cảnh báo vận hành kêu đỏ — không im lặng coi như tắt.
# HEALTH_CHECK_DAILY_AT="09:00"

# ── Sao lưu tự động ra ngoài Railway (GĐ5) ───────────────────────────────────
# Giờ hẹn dạng HH:MM theo TEAM_TIMEZONE. VẮNG MẶT = TẮT. Khai ở BIẾN MÔI TRƯỜNG CỦA MÁY CHỦ.
# Đặt vào giờ đêm để không đụng lượt dò shadowban buổi sáng.
#
# Vì sao phải có, khi Railway đã có sao lưu riêng: bản sao của Railway nằm CÙNG TÀI KHOẢN với bản
# gốc, nên nó không chống được ca mất cả dự án hoặc mất tài khoản. Bản sao ở cùng nhà với bản gốc
# thì không phải bản sao. (Và sao lưu tự động của Railway còn đòi gói Pro.)
# BACKUP_DAILY_AT="03:00"

# Cloudflare R2 — nơi cất bản sao. Bốn biến này phải khai ĐỦ hoặc BỎ TRỐNG CẢ BỐN; khai một nửa
# thì app dừng kèm thông báo, vì "chạy một nửa" ở đây nghĩa là tin rằng mình có bản sao mà không có.
#
# Bucket phải để RIÊNG TƯ, và token R2 chỉ nên có quyền GHI vào đúng bucket này. Token đọc-mọi-thứ
# nằm trong biến môi trường của app là mở rộng thiệt hại của một lần chiếm máy chủ, không thu hẹp.
#
# File gửi lên là bản pg_dump — mọi credential trong đó đã mã hóa, và hai khóa mở chúng KHÔNG có
# mặt ở R2. Người đọc được bucket này cầm một đống ciphertext.
# R2_ACCOUNT_ID=""
# R2_BUCKET=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""

# Ngăn R2 chứa GÓI CÀI CẦU NỐI — bucket khác và token khác với bốn biến ở trên (QĐ 12).
#
# Vì sao không dùng chung: token sao lưu nằm cùng chỗ với VAULT_KEY_SERVER, nên một chìa mở được
# mọi ngăn là MỞ RỘNG thiệt hại của một lần chiếm máy chủ. Ngăn gói cài chứa thứ công khai được
# (mất nó không mất gì); ngăn sao lưu thì không.
#
# TRÊN MÁY CHỦ: token chỉ cần quyền ĐỌC. Khai đủ bốn biến thì /relay-download lấy gói từ R2; bỏ
# trống cả bốn thì nó tìm trên đĩa ở relay/dist (đường của máy dev vừa build xong).
#
# TRÊN MÁY BUILD (Windows, của quản trị viên): token cần quyền GHI để chạy `npm run relay:publish`.
# Chìa ghi đó KHÔNG được đặt lên máy chủ.
# RELAY_RELEASE_R2_ACCOUNT_ID=""
# RELAY_RELEASE_R2_BUCKET=""
# RELAY_RELEASE_R2_ACCESS_KEY_ID=""
# RELAY_RELEASE_R2_SECRET_ACCESS_KEY=""

# Chìa cho MÁY DỰNG tải gói Relay đã ghim — CHỈ TRÊN MÁY CHỦ. Tối thiểu 32 ký tự; ngắn hơn thì máy
# chủ dừng hẳn chứ không lặng lẽ nhận.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Nó mở ĐÚNG MỘT việc: tải một bản Relay đã phát hành, theo số phiên bản, ở /api/relay/download/vN.
# Không dựng ra người dùng nào, không mở được gì khác. Bỏ trống thì tuyến đó vẫn phục vụ người đã
# đăng nhập như cũ — máy dev không cần khai.
#
# Có nó để bộ dựng installer khỏi phải mượn cookie phiên của một người thật: cookie mở cả kho danh
# tính, lại còn hết hạn giữa chừng và chết theo người rời team.
#
# Xoay vòng: đổi giá trị rồi deploy lại, và đặt giá trị mới vào MKTTOOL_RELEASE_TOKEN ở máy dựng.
# RELAY_RELEASE_DOWNLOAD_TOKEN=""

# Combined per-user Windows installer served by the authenticated setup download route.
# MKT_BROWSER_INSTALLER_PATH="C:\release\MKTBrowser-win-x64.exe"

# Địa chỉ web mà cầu nối tin — CHỈ CẦN TRÊN MÁY BUILD, và nó được **nung vào `.exe`** lúc chạy
# `npm run relay:build`. Không phải bí mật: đây là địa chỉ công khai của chính web app.
#
# Cầu nối cấp header CORS cho đúng một nguồn, và nguồn đó là giá trị nung vào đây. Bỏ trống thì
# gói dựng ra tin `http://localhost:3000` — chạy được ở máy dev, và **vô dụng trên máy operator**:
# mọi nút hỏng theo kiểu CORS, mà không câu lỗi nào của trình duyệt chỉ về phía này.
#
# Bộ đóng gói có in ra nguồn nó vừa nung kèm cảnh báo khi đó là địa chỉ máy dev. Đọc dòng đó
# trước khi `relay:publish` — phát nhầm một gói localhost cho cả team là mỗi máy một lượt cài lại.
#
# Đổi domain thì KHÔNG phải dựng lại `.exe`: `webOrigin` trong `relay-config.json` vẫn ghi đè được.
# RELAY_WEB_ORIGIN="https://mkttool-web-production.up.railway.app"

# Nick Reddit dùng để đối chiếu khi chạy `npm run health:smoke`. Để trống thì dùng "spez"
# (nick sáng lập Reddit — luôn tồn tại, luôn công khai). Không cần đăng nhập, không cần proxy.
HEALTH_SMOKE_USERNAME=""

# Browser-profile provider: mkt-browser | adspower
ANTIDETECT_PROVIDER="mkt-browser"

# Optional MKT Browser MCP loopback origin override. The owned default port is 47822.
MKT_BROWSER_MCP_URL="http://127.0.0.1:47822"

# MKT Browser bearer token. Profile actions fail closed when this token is missing or invalid.
# Copy it from MKT Browser: MCP -> "Connect an agent".
MKT_BROWSER_MCP_TOKEN=""

# AdsPower: địa chỉ local API (chỉ cần khi ANTIDETECT_PROVIDER=adspower)
ADSPOWER_API_URL="http://local.adspower.net:50325"

# ── Facebook Pages (Phase 04) ────────────────────────────────────────────────
# Bỏ trống cũng chạy được cả app; chỉ cần khi muốn đăng Fanpage bằng Graph API.
# Tạo app loại Business ở developers.facebook.com, xin 3 quyền:
#   pages_manage_posts, pages_read_engagement, pages_show_list
# Chế độ Development là đủ cho Page mình sở hữu — không cần App Review.
FACEBOOK_APP_ID=""
# App Secret chỉ nằm ở server, KHÔNG BAO GIỜ gửi xuống trình duyệt.
FACEBOOK_APP_SECRET=""
# Phải khai y hệt chuỗi này trong Meta App — Facebook so từng ký tự.
# Host ở đây cũng phải trùng địa chỉ bạn dùng để mở app: cookie chống CSRF của luồng OAuth
# gắn theo host, và "localhost" với "127.0.0.1" là hai host khác nhau với cookie.
FACEBOOK_REDIRECT_URI="http://localhost:3000/api/facebook/oauth/callback"
# Phiên bản Graph API. Để trống thì dùng mặc định trong facebook-app-config.ts.
FACEBOOK_GRAPH_VERSION=""
# CHỈ điền khi app dùng sản phẩm "Facebook Login for Business" (app loại Business tạo từ 2025
# chỉ thêm được bản này). Lấy ở: Facebook Login for Business -> Configurations -> cột ID.
# Điền vào là quyền lấy theo configuration đó, KHÔNG lấy theo scope trong code nữa — nên phải
# tick đủ pages_manage_posts + pages_read_engagement + pages_show_list khi tạo configuration.
# Dùng Facebook Login thường thì để trống.
FACEBOOK_LOGIN_CONFIG_ID=""
